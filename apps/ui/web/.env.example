# Frontend runtime config. The deploy pipeline writes the real values into
# .env.production at build time (deploy.sh for CDK; null_resource.deploy_ui for
# Terraform). Copy this file to .env.local to run `npm run dev` against an
# already-deployed backend. No live IDs belong in this template.
VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_API_URL=
VITE_AGENTCORE_RUNTIME_ARN=
# The ontology page's retrieval runtime — a second AgentCore runtime, invoked the
# same way as the chat one. Without it the Ask panel reports that it is unconfigured.
VITE_ONTOLOGY_AGENT_RUNTIME_ARN=
# Display name shown in the UI. Sourced from AppConfig.json (displayName) at deploy time.
VITE_APP_NAME=JustifyAI
# Cognito hosted-UI domain (bare host, no scheme). Written only when AppConfig.json
# configures a federatedIdp — its presence enables the federated SSO button.
VITE_COGNITO_DOMAIN=
