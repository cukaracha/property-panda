# Frontend runtime config. run.sh writes the real .env.local on first start, reading
# the two names out of AppConfig.json, so there is usually nothing to do by hand here.

# The local scraper and assistant API (apps/local/property_search).
VITE_LISTINGS_API_URL=http://localhost:8000

# Names shown in the UI. Sourced from AppConfig.json (displayName, assistantName).
VITE_APP_NAME=Property Panda
VITE_ASSISTANT_NAME=Panda-chan
